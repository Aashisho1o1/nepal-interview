# Server-side configuration for the session API and the reconciler.
# Never expose any of these to the browser. apps/web/.env.example has the only
# browser-side settings (where to proxy /api, which iframe origins may use the mic).

# ---- session API (services/api)
DATABASE_URL=postgresql://localhost/nepal_interview
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=true             # false only for plain-http local development
VIDEO_TIER_ENABLED=true        # kill switch for the video interviewer
VOICE_TIER_ENABLED=true        # kill switch for the voice interviewer
GRADER=rules                   # or openai (needs OPENAI_API_KEY + GRADER_MODEL)
OPENAI_API_KEY=
GRADER_MODEL=
PRICE_TABLE_PATH=              # defaults to config/prices.json
PROVIDERS_FILE=                # defaults to config/providers.json
ENABLED_PROVIDERS=             # optional comma list to restrict, e.g. elevenlabs_voice
CLIENT_HEARTBEAT_TIMEOUT_S=90  # browser heartbeats; phones throttle timers when dimmed

# ---- voice tier: ElevenLabs agent (see docs/ELEVENLABS_LIVEAVATAR_FOCUS.md)
ELEVENLABS_AGENT_ID=           # the interviewer agent ("Officer Miller")
ELEVENLABS_BRANCH_ID=          # optional agent branch
ELEVENLABS_API_KEY=            # private agent: the server mints per-session tokens
ELEVENLABS_ALLOW_PUBLIC_AGENT=false  # true only for local testing with a public agent
ELEVENLABS_WEBHOOK_SECRET=     # post-call transcript webhook (not wired yet)

# ---- video tier: HeyGen LiveAvatar
LIVEAVATAR_EMBED_URL=          # static embed: https://embed.liveavatar.com/v1/<embed-id>?orientation=horizontal
LIVEAVATAR_API_KEY=            # session-token flow (not wired yet)
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_ELEVENLABS_SECRET_ID=
LIVEAVATAR_SANDBOX=true

# ---- hosting on Vercel (see README "Deploy on Vercel")
CRON_SECRET=                   # random, 16+ chars; Vercel Cron sends it to /api/internal/reconcile
