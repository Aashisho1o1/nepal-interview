# Server-side configuration for the session API and the interview agent.
# Never expose any of these to the browser. apps/web/.env.example has the only
# browser-side setting (where to proxy /api).

# ---- shared
LIVEKIT_URL=                 # must be reachable from the internet (Simli joins the room)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=nepal-interview-agent
INTERNAL_API_TOKEN=          # long random string; agent -> API service auth

# ---- session API (services/api)
DATABASE_URL=postgresql://localhost/nepal_interview
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=true           # false only for plain-http local development
AVATAR_ENABLED=true          # kill switch: false sends everyone to voice
SESSIONS_ENABLED=true        # kill switch: false refuses all new sessions
VOICE_ENGINE=openai_realtime # or cascade
GRADER=rules                 # or openai (needs OPENAI_API_KEY + GRADER_MODEL)
GRADER_MODEL=
PRICE_TABLE_PATH=            # defaults to config/prices.json
MEDIA_BACKEND=livekit        # "fake" only for UI work without LiveKit

# ---- agent (services/agent)
SESSION_API_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
SIMLI_API_KEY=
SIMLI_FACE_ID=               # a licensed fictional face; there is deliberately no default
AWAY_TIMEOUT_S=15
LONG_ANSWER_S=60

# ---- interview providers (see docs/PROVIDERS.md)
PROVIDERS_FILE=                # defaults to config/providers.json
ENABLED_PROVIDERS=             # optional comma list to restrict, e.g. liveavatar_embed,livekit_voice
CLIENT_HEARTBEAT_TIMEOUT_S=90  # browser heartbeats for embeds/hosted vendors
LIVEAVATAR_EMBED_URL=          # https://embed.liveavatar.com/v1/<embed-id>?orientation=horizontal
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=                  # optional
TAVUS_WEBHOOK_SECRET=          # long random string; enables transcripts via webhook
TAVUS_REQUIRE_AUTH=false
PUBLIC_BASE_URL=               # e.g. https://practice.example.com (for vendor webhooks)
