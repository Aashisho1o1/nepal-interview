{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "asgi:app",
      "functions": {
        "asgi.py": {
          "excludeFiles": "{apps/**,docs/**,tests/**,scripts/**,interviewer/**,.venv/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/internal/reconcile", "schedule": "* * * * *" }
  ]
}
