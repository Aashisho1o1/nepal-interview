# Local development only: the session API that `next dev` proxies /api/* to. On Vercel,
# vercel.json routes /api/* to the API service and this is ignored. No provider secrets here:
# ElevenLabs and LiveAvatar keys live only in the API environment.
SESSION_API_ORIGIN=http://localhost:8000
# Origins of vendor iframes allowed to use the microphone (must match providers.json allowed_hosts).
IFRAME_ORIGINS=
