# The session API the Next.js server proxies /api/* to. No provider secrets here:
# LiveKit, Simli and OpenAI keys live only in the API and agent environments.
SESSION_API_ORIGIN=http://localhost:8000
# Origins of vendor iframes allowed to use the microphone (must match providers.json allowed_hosts).
EMBED_ORIGINS=https://embed.liveavatar.com https://tavus.daily.co
